# Signal Engine Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# LiteLLM Proxy URL
# Get this from your LiteLLM admin dashboard
LITELLM_BASE_URL=https://litellm.labb.site/v1

# LiteLLM API Key
# Obtain this from your LiteLLM admin dashboard
LITELLM_API_KEY=your-api-key-here

# Optional: Custom config path (uses config/sources.yaml by default)
# SIGNAL_ENGINE_CONFIG=/path/to/sources.yaml